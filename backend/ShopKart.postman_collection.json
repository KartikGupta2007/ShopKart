{
  "info": {
    "name": "ShopKart — Auth (Lab 01) + Products (Lab 03) + Cart (Lab 05)",
    "description": "Two folders. Auth: Register -> Login -> My Profile -> Change Password -> Logout; Postman stores the HttpOnly token cookie automatically. Products: run 'Create Product' first — its test script saves the new _id into the {{productId}} variable, so the single-product requests work without copy-pasting an id. Cart: set {{productId}} (run Products → Create Product, or paste a seeded product's _id), edit the Login body to an account you registered, then run the folder top to bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
