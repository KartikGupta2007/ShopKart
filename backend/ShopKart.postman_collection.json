    {
      "name": "Cart (Lab 05)",
      "item": [
        {
          "name": "0. Login first (sets the cookie)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@gmail.com\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "1. Add new item → quantity 1",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart",
                "{{productId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const row = body.cart.find((item) => item.product._id === pm.collectionVariables.get('productId'));",
                  "pm.test('quantity is 1', () => pm.expect(row && row.quantity).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Add same item again → quantity 2",
          "request": {
            "method": "POST",
            "header": [],
