              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the new product's _id so the GET /products/:id requests",
                  "// below can run without pasting an id by hand.",
                  "const body = pm.response.json();",
                  "if (body.product && body.product._id) {",
                  "  pm.collectionVariables.set('productId', body.product._id);",
                  "  console.log('productId =', body.product._id);",
                  "}",
                  "",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
